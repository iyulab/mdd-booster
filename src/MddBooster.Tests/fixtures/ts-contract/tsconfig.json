{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "generated/**/*.ts",
    "generated/**/*.tsx",
    "consumer/**/*.tsx"
  ]
}
